{
  "manifest_version": 3,
  "name": "Codex Work Tabs",
  "version": "0.4.1",
  "description": "Unofficial local bridge for Codex work tabs. No codes, tokens or profile paths.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a171de16-96b6-4e50-94b7-e0b54d94436a}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "websiteActivity"]
      }
    }
  },
  "permissions": ["nativeMessaging", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/cursor-16.png",
    "32": "icons/cursor-32.png",
    "48": "icons/cursor-48.png",
    "96": "icons/cursor-96.png",
    "128": "icons/cursor-128.png"
  },
  "background": {
    "scripts": ["protocol.js", "native/background.js"]
  },
  "action": {
    "default_icon": { "16": "icons/cursor-16.png", "32": "icons/cursor-32.png" },
    "default_title": "Codex Work Tabs",
    "default_popup": "native/popup.html"
  },
  "options_ui": {
    "page": "native/popup.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "incognito": "not_allowed"
}
